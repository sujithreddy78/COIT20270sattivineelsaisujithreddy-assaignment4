enum AppRoute {
  home,
  toolLibrary,
  toolDetails,
  borrowRequest,
  requestStatus,
  coordinatorApproval,
  approvedCollection,
  borrowedTools,
  returnTool,
  returnRecord,
}

enum ToolAvailability { available, onLoan, maintenance }

enum BorrowRequestStatus {
  pending,
  approved,
  rejected,
  collected,
  returned,
}

enum ReturnCondition {
  good,
  minorDamage,
  damaged,
  requiresMaintenance,
}

class ToolItem {
  ToolItem({
    required this.name,
    required this.category,
    required this.description,
    required this.safetyInformation,
    required this.icon,
    required this.availability,
    required this.condition,
  });

  final String name;
  final String category;
  final String description;
  final String safetyInformation;
  final IconData icon;
  ToolAvailability availability;
  String condition;
}

class BorrowRequestRecord {
  BorrowRequestRecord({
    required this.memberName,
    required this.tool,
    required this.requestedOn,
    required this.dueOn,
    required this.status,
  });

  final String memberName;
  final ToolItem tool;
  final DateTime requestedOn;
  final DateTime dueOn;
  BorrowRequestStatus status;
}

class BorrowedToolRecord {
  BorrowedToolRecord({
    required this.memberName,
    required this.tool,
    required this.borrowedOn,
    required this.dueOn,
  });

  final String memberName;
  final ToolItem tool;
  final DateTime borrowedOn;
  final DateTime dueOn;
  bool returned = false;
  DateTime? returnedOn;
  ReturnCondition? returnedCondition;
  String returnNotes = '';
}

class MemberRecord {
  const MemberRecord({
    required this.id,
    required this.name,
    required this.role,
  });

  final String id;
  final String name;
  final String role;
}

class HmsRepository {
  HmsRepository() {
    _member = const MemberRecord(
      id: 'HMS-001',
      name: 'James Smith',
      role: 'HMS member',
    );
    _tools.addAll(_buildSeedTools());
  }

  late MemberRecord _member;
  final List<ToolItem> _tools = [];
  final List<BorrowedToolRecord> _borrowedRecords = [];
  BorrowRequestRecord? _activeRequest;
  BorrowedToolRecord? _lastReturnedRecord;

  MemberRecord get member => _member;
  List<ToolItem> get tools => List.unmodifiable(_tools);
  List<BorrowedToolRecord> get borrowedRecords =>
      List.unmodifiable(_borrowedRecords);
  BorrowRequestRecord? get activeRequest => _activeRequest;
  BorrowedToolRecord? get lastReturnedRecord => _lastReturnedRecord;

  // The repository acts as the simulated backend boundary. Only initial seed
  // data is hardcoded; requests, loans, returns and inventory changes are
  // created and updated through repository operations.
  List<ToolItem> _buildSeedTools() {
    return [
      ToolItem(
        name: 'Compound mitre saw',
        category: 'Power Tools',
        description:
            'A bench-mounted saw for accurate cross-cuts and angled timber cuts.',
        safetyInformation:
            'Wear eye and hearing protection. Keep hands outside the marked cutting zone.',
        icon: Icons.carpenter,
        availability: ToolAvailability.available,
        condition: 'Good - inspected',
      ),
      ToolItem(
        name: 'Pedestal drill',
        category: 'Mechanical',
        description:
            'A fixed drill press for controlled and repeatable drilling operations.',
        safetyInformation:
            'Secure the workpiece, remove the chuck key and tie back loose clothing.',
        icon: Icons.precision_manufacturing,
        availability: ToolAvailability.available,
        condition: 'Good - inspected',
      ),
      ToolItem(
        name: 'Bandsaw',
        category: 'Woodworking',
        description:
            'A workshop bandsaw for straight and curved cuts in suitable materials.',
        safetyInformation:
            'Complete the relevant induction and keep the blade guard close to the workpiece.',
        icon: Icons.handyman,
        availability: ToolAvailability.maintenance,
        condition: 'Blade inspection required',
      ),
      ToolItem(
        name: 'Cordless drill/driver',
        category: 'Power Tools',
        description:
            'A portable drill and driver for workshop assembly and repair tasks.',
        safetyInformation:
            'Select the correct bit and torque setting. Remove the battery before changing bits.',
        icon: Icons.construction,
        availability: ToolAvailability.available,
        condition: 'Good',
      ),
      ToolItem(
        name: 'No. 4 hand plane',
        category: 'Hand Tools',
        description:
            'A smoothing plane for preparing timber surfaces and refining edges.',
        safetyInformation:
            'Retract or cover the blade when stored and keep fingers clear of the cutting edge.',
        icon: Icons.hardware,
        availability: ToolAvailability.available,
        condition: 'Good',
      ),
      ToolItem(
        name: 'Orbital sander',
        category: 'Carpentry',
        description:
            'A random-orbit sander for preparing timber before finishing.',
        safetyInformation:
            'Use dust extraction and respiratory protection appropriate to the material.',
        icon: Icons.home_repair_service,
        availability: ToolAvailability.available,
        condition: 'Good',
      ),
      ToolItem(
        name: 'Metal bench vice',
        category: 'Metalworking',
        description:
            'A heavy bench vice for safely holding suitable metal components.',
        safetyInformation:
            'Secure work fully and do not extend the handle with improvised leverage.',
        icon: Icons.build,
        availability: ToolAvailability.available,
        condition: 'Good',
      ),
    ];
  }

  ToolItem? _toolByName(String? name) {
    if (name == null) return null;
    for (final tool in _tools) {
      if (tool.name == name) return tool;
    }
    return null;
  }

  BorrowRequestRecord? createBorrowRequest({
    required ToolItem tool,
    required DateTime requestedOn,
    required DateTime dueOn,
  }) {
    if (!_tools.contains(tool) ||
        tool.availability != ToolAvailability.available ||
        (_activeRequest?.status == BorrowRequestStatus.pending)) {
      return null;
    }

    _activeRequest = BorrowRequestRecord(
      memberName: _member.name,
      tool: tool,
      requestedOn: requestedOn,
      dueOn: dueOn,
      status: BorrowRequestStatus.pending,
    );
    return _activeRequest;
  }

  bool canDecideRequest({required bool approve}) {
    final request = _activeRequest;
    if (request == null || request.status != BorrowRequestStatus.pending) {
      return false;
    }
    if (approve && request.tool.availability != ToolAvailability.available) {
      return false;
    }
    return true;
  }

  bool updateRequestDecision({required bool approve}) {
    if (!canDecideRequest(approve: approve)) return false;
    _activeRequest!.status =
        approve ? BorrowRequestStatus.approved : BorrowRequestStatus.rejected;
    return true;
  }

  BorrowedToolRecord? confirmCollection({required DateTime collectedOn}) {
    final request = _activeRequest;
    if (request == null ||
        request.status != BorrowRequestStatus.approved ||
        request.tool.availability != ToolAvailability.available) {
      return null;
    }

    for (final record in _borrowedRecords) {
      if (record.tool == request.tool && !record.returned) {
        return record;
      }
    }

    request.status = BorrowRequestStatus.collected;
    request.tool.availability = ToolAvailability.onLoan;

    final record = BorrowedToolRecord(
      memberName: request.memberName,
      tool: request.tool,
      borrowedOn: collectedOn,
      dueOn: request.dueOn,
    );
    _borrowedRecords.add(record);
    return record;
  }

  BorrowedToolRecord? completeReturn({
    required BorrowedToolRecord record,
    required ReturnCondition condition,
    required String notes,
    required DateTime returnedOn,
  }) {
    if (!_borrowedRecords.contains(record) || record.returned) return null;

    final requiresInspection = condition != ReturnCondition.good;
    record.returned = true;
    record.returnedOn = returnedOn;
    record.returnedCondition = condition;
    record.returnNotes = notes.trim();
    record.tool.condition = returnConditionLabel(condition);
    record.tool.availability = requiresInspection
        ? ToolAvailability.maintenance
        : ToolAvailability.available;

    if (_activeRequest?.tool == record.tool) {
      _activeRequest!.status = BorrowRequestStatus.returned;
    }
    _lastReturnedRecord = record;
    return record;
  }

  Map<String, dynamic> exportState() {
    String? date(DateTime? value) => value?.toIso8601String();
    return {
      'member': {
        'id': _member.id,
        'name': _member.name,
        'role': _member.role,
      },
      'tools': _tools
          .map((tool) => {
                'name': tool.name,
                'availability': tool.availability.index,
                'condition': tool.condition,
              })
          .toList(),
      'request': _activeRequest == null
          ? null
          : {
              'member': _activeRequest!.memberName,
              'tool': _activeRequest!.tool.name,
              'requestedOn': date(_activeRequest!.requestedOn),
              'dueOn': date(_activeRequest!.dueOn),
              'status': _activeRequest!.status.index,
            },
      'loans': _borrowedRecords
          .map((record) => {
                'member': record.memberName,
                'tool': record.tool.name,
                'borrowedOn': date(record.borrowedOn),
                'dueOn': date(record.dueOn),
                'returned': record.returned,
                'returnedOn': date(record.returnedOn),
                'returnedCondition': record.returnedCondition?.index,
                'notes': record.returnNotes,
              })
          .toList(),
      'lastReturnedTool': _lastReturnedRecord?.tool.name,
    };
  }

  void restoreState(Map<String, dynamic> data) {
    final memberData = data['member'];
    if (memberData is Map<String, dynamic>) {
      _member = MemberRecord(
        id: memberData['id'] as String? ?? _member.id,
        name: memberData['name'] as String? ?? _member.name,
        role: memberData['role'] as String? ?? _member.role,
      );
    }

    final toolStates = data['tools'] as List<dynamic>? ?? const [];
    for (final entry in toolStates) {
      if (entry is! Map<String, dynamic>) continue;
      final tool = _toolByName(entry['name'] as String?);
      if (tool == null) continue;
      final availability = entry['availability'] as int?;
      if (availability != null &&
          availability >= 0 &&
          availability < ToolAvailability.values.length) {
        tool.availability = ToolAvailability.values[availability];
      }
      tool.condition = entry['condition'] as String? ?? tool.condition;
    }

    _borrowedRecords.clear();
    final loanData = data['loans'] as List<dynamic>? ?? const [];
    for (final entry in loanData) {
      if (entry is! Map<String, dynamic>) continue;
      final tool = _toolByName(entry['tool'] as String?);
      final borrowedOn = entry['borrowedOn'] as String?;
      final dueOn = entry['dueOn'] as String?;
      if (tool == null || borrowedOn == null || dueOn == null) continue;

      final record = BorrowedToolRecord(
        memberName: entry['member'] as String? ?? _member.name,
        tool: tool,
        borrowedOn: DateTime.parse(borrowedOn),
        dueOn: DateTime.parse(dueOn),
      );
      record.returned = entry['returned'] as bool? ?? false;
      final returnedOn = entry['returnedOn'] as String?;
      if (returnedOn != null) record.returnedOn = DateTime.parse(returnedOn);
      final conditionIndex = entry['returnedCondition'] as int?;
      if (conditionIndex != null &&
          conditionIndex >= 0 &&
          conditionIndex < ReturnCondition.values.length) {
        record.returnedCondition = ReturnCondition.values[conditionIndex];
      }
      record.returnNotes = entry['notes'] as String? ?? '';
      _borrowedRecords.add(record);
    }

    final requestData = data['request'];
    if (requestData is Map<String, dynamic>) {
      final tool = _toolByName(requestData['tool'] as String?);
      final requestedOn = requestData['requestedOn'] as String?;
      final dueOn = requestData['dueOn'] as String?;
      final statusIndex = requestData['status'] as int?;
      if (tool != null &&
          requestedOn != null &&
          dueOn != null &&
          statusIndex != null &&
          statusIndex >= 0 &&
          statusIndex < BorrowRequestStatus.values.length) {
        _activeRequest = BorrowRequestRecord(
          memberName: requestData['member'] as String? ?? _member.name,
          tool: tool,
          requestedOn: DateTime.parse(requestedOn),
          dueOn: DateTime.parse(dueOn),
          status: BorrowRequestStatus.values[statusIndex],
        );
      } else {
        _activeRequest = null;
      }
    } else {
      _activeRequest = null;
    }

    _lastReturnedRecord = null;
    final lastReturnedTool = data['lastReturnedTool'] as String?;
    if (lastReturnedTool != null) {
      for (final record in _borrowedRecords.reversed) {
        if (record.tool.name == lastReturnedTool && record.returned) {
          _lastReturnedRecord = record;
          break;
        }
      }
    }
  }
}

class HmsAppController extends ChangeNotifier {
  HmsAppController({HmsRepository? repository})
      : repository = repository ?? HmsRepository() {
    selectedTool = tools.first;
    final activeLoans = borrowedRecords.where((record) => !record.returned);
    if (activeLoans.isNotEmpty) {
      selectedBorrowedRecord = activeLoans.first;
    }
  }

  final HmsRepository repository;
  final List<AppRoute> _routeHistory = [AppRoute.home];

  MemberRecord get member => repository.member;
  String get memberName => member.name;
  List<ToolItem> get tools => repository.tools;
  List<BorrowedToolRecord> get borrowedRecords => repository.borrowedRecords;
  BorrowRequestRecord? get activeRequest => repository.activeRequest;
  BorrowedToolRecord? get lastReturnedRecord => repository.lastReturnedRecord;

  AppRoute currentRoute = AppRoute.home;
  ToolItem? selectedTool;
  DateTime? selectedReturnDate;
  String? returnDateError;
  BorrowedToolRecord? selectedBorrowedRecord;
  ReturnCondition? selectedReturnCondition;
  String returnNotes = '';

  int get selectedDestination => destinationForRoute(currentRoute);

  bool get isTopLevelRoute =>
      currentRoute == AppRoute.home ||
      currentRoute == AppRoute.toolLibrary ||
      currentRoute == AppRoute.borrowedTools ||
      currentRoute == AppRoute.coordinatorApproval;

  String get screenTitle {
    switch (currentRoute) {
      case AppRoute.home:
        return 'HMS Tool Library';
      case AppRoute.toolLibrary:
        return 'Tool Library';
      case AppRoute.toolDetails:
        return 'Tool Details';
      case AppRoute.borrowRequest:
        return 'Borrow Request';
      case AppRoute.requestStatus:
        return 'Request Status';
      case AppRoute.coordinatorApproval:
        return 'Coordinator Approval';
      case AppRoute.approvedCollection:
        return 'Approved Collection';
      case AppRoute.borrowedTools:
        return 'My Borrowed Tools';
      case AppRoute.returnTool:
        return 'Return Tool';
      case AppRoute.returnRecord:
        return 'Return Record';
    }
  }

  void selectDestination(int index) {
    final route = switch (index) {
      0 => AppRoute.home,
      1 => AppRoute.toolLibrary,
      2 => AppRoute.borrowedTools,
      _ => AppRoute.coordinatorApproval,
    };
    goTo(route);
  }

  void goTo(AppRoute route, {bool addToHistory = true}) {
    if (route == currentRoute) return;
    if (route == AppRoute.toolDetails && selectedTool == null) {
      selectedTool = tools.first;
    }
    if (route == AppRoute.returnTool && selectedBorrowedRecord == null) {
      final activeLoans = borrowedRecords.where((record) => !record.returned);
      if (activeLoans.isNotEmpty) selectedBorrowedRecord = activeLoans.first;
    }
    if (addToHistory) {
      if (_routeHistory.isEmpty || _routeHistory.last != currentRoute) {
        _routeHistory.add(currentRoute);
      }
    }
    currentRoute = route;
    notifyListeners();
  }

  void goBack() {
    if (_routeHistory.isNotEmpty) {
      final previous = _routeHistory.removeLast();
      currentRoute = previous;
      notifyListeners();
      return;
    }
    if (currentRoute != AppRoute.home) {
      currentRoute = AppRoute.home;
      notifyListeners();
    }
  }

  int destinationForRoute(AppRoute route) {
    switch (route) {
      case AppRoute.home:
        return 0;
      case AppRoute.toolLibrary:
      case AppRoute.toolDetails:
      case AppRoute.borrowRequest:
      case AppRoute.requestStatus:
        return 1;
      case AppRoute.borrowedTools:
      case AppRoute.returnTool:
      case AppRoute.returnRecord:
        return 2;
      case AppRoute.coordinatorApproval:
      case AppRoute.approvedCollection:
        return 3;
    }
  }

  void selectTool(ToolItem tool) {
    selectedTool = tool;
    goTo(AppRoute.toolDetails);
  }

  void prepareBorrowRequest() {
    selectedReturnDate = null;
    returnDateError = null;
    goTo(AppRoute.borrowRequest);
  }

  void setReturnDate(DateTime date) {
    selectedReturnDate = DateUtils.dateOnly(date);
    returnDateError = null;
    notifyListeners();
  }

  bool submitBorrowRequest() {
    final tool = selectedTool;
    final date = selectedReturnDate;
    final today = DateUtils.dateOnly(DateTime.now());

    if (tool == null) {
      returnDateError = 'Select an available tool before continuing.';
      notifyListeners();
      return false;
    }
    if (date == null) {
      returnDateError = 'Select an expected return date.';
      notifyListeners();
      return false;
    }
    if (!date.isAfter(today)) {
      returnDateError = 'The return date must be after today.';
      notifyListeners();
      return false;
    }
    if (tool.availability != ToolAvailability.available) {
      returnDateError = 'This tool is no longer available to request.';
      notifyListeners();
      return false;
    }
    if (activeRequest?.status == BorrowRequestStatus.pending) {
      returnDateError = 'Finish the current pending request before creating another.';
      notifyListeners();
      return false;
    }

    final created = repository.createBorrowRequest(
      tool: tool,
      requestedOn: today,
      dueOn: date,
    );
    if (created == null) {
      returnDateError = 'The request could not be created in its current state.';
      notifyListeners();
      return false;
    }

    returnDateError = null;
    goTo(AppRoute.requestStatus);
    return true;
  }

  bool canDecideRequest(bool approve) {
    return repository.canDecideRequest(approve: approve);
  }

  void decideRequest(bool approve) {
    if (!repository.updateRequestDecision(approve: approve)) return;
    goTo(approve ? AppRoute.approvedCollection : AppRoute.requestStatus);
  }

  bool confirmCollection() {
    final record = repository.confirmCollection(
      collectedOn: DateUtils.dateOnly(DateTime.now()),
    );
    if (record == null) return false;
    selectedBorrowedRecord = record;
    goTo(AppRoute.borrowedTools);
    return true;
  }

  void startReturn(BorrowedToolRecord record) {
    selectedBorrowedRecord = record;
    selectedReturnCondition = null;
    returnNotes = '';
    goTo(AppRoute.returnTool);
  }

  void setReturnCondition(ReturnCondition condition) {
    selectedReturnCondition = condition;
    notifyListeners();
  }

  void setReturnNotes(String notes) {
    returnNotes = notes;
    notifyListeners();
  }

  bool completeReturn() {
    final record = selectedBorrowedRecord;
    final condition = selectedReturnCondition;
    if (record == null || record.returned || condition == null) return false;

    final updated = repository.completeReturn(
      record: record,
      condition: condition,
      notes: returnNotes,
      returnedOn: DateUtils.dateOnly(DateTime.now()),
    );
    if (updated == null) return false;

    goTo(AppRoute.returnRecord);
    return true;
  }

  String createSnapshot() {
    String? date(DateTime? value) => value?.toIso8601String();
    return jsonEncode({
      'route': currentRoute.index,
      'selectedTool': selectedTool?.name,
      'selectedReturnDate': date(selectedReturnDate),
      'selectedBorrowedTool': selectedBorrowedRecord?.tool.name,
      'selectedReturnCondition': selectedReturnCondition?.index,
      'returnNotes': returnNotes,
      'backend': repository.exportState(),
    });
  }

  void restoreSnapshot(String raw) {
    if (raw.trim().isEmpty) return;
    try {
      final data = jsonDecode(raw) as Map<String, dynamic>;
      final backendData = data['backend'];
      if (backendData is Map<String, dynamic>) {
        repository.restoreState(backendData);
      } else {
        // Backward-compatible fallback for snapshots created by the previous
        // version, where backend fields were stored at the root level.
        repository.restoreState(data);
      }

      final routeIndex = data['route'] as int?;
      if (routeIndex != null &&
          routeIndex >= 0 &&
          routeIndex < AppRoute.values.length) {
        currentRoute = AppRoute.values[routeIndex];
      }

      final selectedToolName = data['selectedTool'] as String?;
      selectedTool = tools
              .where((item) => item.name == selectedToolName)
              .firstOrNull ??
          tools.first;

      final returnDate = data['selectedReturnDate'] as String?;
      selectedReturnDate =
          returnDate == null ? null : DateTime.parse(returnDate);

      final selectedBorrowedToolName = data['selectedBorrowedTool'] as String?;
      selectedBorrowedRecord = borrowedRecords
          .where((record) => record.tool.name == selectedBorrowedToolName)
          .firstOrNull;

      final conditionIndex = data['selectedReturnCondition'] as int?;
      selectedReturnCondition = conditionIndex != null &&
              conditionIndex >= 0 &&
              conditionIndex < ReturnCondition.values.length
          ? ReturnCondition.values[conditionIndex]
          : null;
      returnNotes = data['returnNotes'] as String? ?? '';
      notifyListeners();
    } catch (_) {
      // Corrupt or incompatible restoration data is ignored; repository seed
      // data remains available so the application can still start safely.
    }
  }
}

extension FirstOrNullExtension<T> on Iterable<T> {
  T? get firstOrNull => isEmpty ? null : first;
}

class HmsAppShell extends StatefulWidget {
  const HmsAppShell({super.key});

  @override
  State<HmsAppShell> createState() => _HmsAppShellState();
}

class _HmsAppShellState extends State<HmsAppShell> with RestorationMixin {
  final HmsAppController _appState = HmsAppController();
  final RestorableString _persistedSnapshot = RestorableString('');

  @override
  String? get restorationId => 'hms-app-state-a4-v3';

  @override
  void initState() {
    super.initState();
    _appState.addListener(_handleStateChange);
  }

  @override
  void restoreState(RestorationBucket? oldBucket, bool initialRestore) {
    registerForRestoration(_persistedSnapshot, 'workflow_snapshot_a4_v3');
    if (_persistedSnapshot.value.isNotEmpty) {
      _appState.restoreSnapshot(_persistedSnapshot.value);
    }
  }

  void _handleStateChange() {
    if (mounted) {
      setState(() {});
      _persistedSnapshot.value = _appState.createSnapshot();
    }
  }

  @override
  void dispose() {
    _appState.removeListener(_handleStateChange);
    _appState.dispose();
    _persistedSnapshot.dispose();
    super.dispose();
  }

  void _showFeedback(String message) {
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(SnackBar(content: Text(message)));
  }

  Future<void> _chooseReturnDate() async {
    final today = DateUtils.dateOnly(DateTime.now());
    final selectedDate = await showDatePicker(
      context: context,
      initialDate: _appState.selectedReturnDate ?? today.add(const Duration(days: 7)),
      firstDate: today.add(const Duration(days: 1)),
      lastDate: today.add(const Duration(days: 90)),
      helpText: 'Select expected return date',
    );
    if (!mounted || selectedDate == null) return;
    _appState.setReturnDate(selectedDate);
  }

  void _submitBorrowRequest() {
    if (_appState.submitBorrowRequest()) {
      _showFeedback('Borrowing request submitted for coordinator review.');
    }
  }

  Future<void> _confirmRequestDecision(bool approve) async {
    final request = _appState.activeRequest;
    if (request == null || !_appState.canDecideRequest(approve)) {
      _showFeedback(
        approve
            ? 'The request cannot be approved in its current state.'
            : 'There is no pending request to reject.',
      );
      return;
    }
    final action = approve ? 'Approve' : 'Reject';
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        icon: Icon(approve ? Icons.task_alt : Icons.cancel_outlined),
        title: Text('$action borrowing request?'),
        content: Text(
          '$action ${request.memberName}\'s request for ${request.tool.name}?',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: const Text('Cancel'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: Text(action),
          ),
        ],
      ),
    );
    if (!mounted || confirmed != true) return;
    _appState.decideRequest(approve);
    _showFeedback(
      approve
          ? 'Request approved. Collection details are ready.'
          : 'Request rejected and the member status was updated.',
    );
  }

  void _confirmCollection() {
    if (_appState.confirmCollection()) {
      _showFeedback('Collection confirmed and the tool is now on loan.');
    } else {
      _showFeedback('Collection cannot be confirmed in the current state.');
    }
  }

  Future<void> _submitReturn() async {
    final record = _appState.selectedBorrowedRecord;
    final condition = _appState.selectedReturnCondition;
    if (record == null || condition == null) {
      _showFeedback('Select the returned tool condition before continuing.');
      return;
    }
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        icon: const Icon(Icons.assignment_turned_in_outlined),
        title: const Text('Submit return record?'),
        content: Text(
          'Record ${record.tool.name} as returned in '
          '${returnConditionLabel(condition).toLowerCase()} condition?',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: const Text('Cancel'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: const Text('Submit return'),
          ),
        ],
      ),
    );
    if (!mounted || confirmed != true) return;
    if (_appState.completeReturn()) {
      _showFeedback(
        condition == ReturnCondition.good
            ? 'Return recorded. The tool is available again.'
            : 'Return recorded. The tool is unavailable pending inspection.',
      );
    }
  }

  void _showPrivacyAndEthics() {
    showModalBottomSheet<void>(
      context: context,
      showDragHandle: true,
      isScrollControlled: true,
      builder: (sheetContext) {
        return SafeArea(
          child: SingleChildScrollView(
            padding: const EdgeInsets.fromLTRB(24, 8, 24, 32),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  'Privacy and ethical design',
                  style: Theme.of(sheetContext).textTheme.titleLarge,
                ),
                const SizedBox(height: 16),
                const DesignCommitment(
                  icon: Icons.data_saver_on_outlined,
                  title: 'Data minimisation',
                  description:
                      'The functional application displays only the member and borrowing information needed for each task.',
                ),
                const DesignCommitment(
                  icon: Icons.admin_panel_settings_outlined,
                  title: 'Role separation',
                  description:
                      'Coordinator functions are separated for assessment. A production deployment would require authenticated role-based access.',
                ),
                const DesignCommitment(
                  icon: Icons.visibility_outlined,
                  title: 'Transparency and autonomy',
                  description:
                      'Requests show their status and consequential actions require confirmation.',
                ),
                const DesignCommitment(
                  icon: Icons.health_and_safety_outlined,
                  title: 'Safety and fairness',
                  description:
                      'Damaged tools remain unavailable, labels avoid hidden conditions and accessible alternatives are provided for gestures.',
                ),
                const DesignCommitment(
                  icon: Icons.storage_outlined,
                  title: 'Simulated backend and restoration',
                  description:
                      'Seed data is separated from user-driven outcomes, while Flutter state restoration preserves the assessment workflow without external packages.',
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  Widget _transitionedBody() {
    // A deliberately visible 700 ms transition lets the marker observe route
    // continuity while remaining predictable and non-distracting for users.
    return AnimatedSwitcher(
      duration: const Duration(milliseconds: 700),
      reverseDuration: const Duration(milliseconds: 700),
      switchInCurve: Curves.easeOutCubic,
      switchOutCurve: Curves.easeInCubic,
      transitionBuilder: (child, animation) {
        final offset = Tween<Offset>(
          begin: const Offset(0.025, 0),
          end: Offset.zero,
        ).animate(animation);
        return FadeTransition(
          opacity: animation,
          child: SlideTransition(position: offset, child: child),
        );
      },
      child: KeyedSubtree(
        key: ValueKey(_appState.currentRoute),
        child: _buildCurrentScreen(),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final useNavigationRail = constraints.maxWidth >= 760;
        final extendNavigationRail = constraints.maxWidth >= 1120;
        final screenBody = _transitionedBody();

        return Scaffold(
          appBar: AppBar(
            automaticallyImplyLeading: false,
            leading: _appState.isTopLevelRoute
                ? null
                : Tooltip(
                    message: 'Back',
                    child: BackButton(onPressed: _appState.goBack),
                  ),
            title: Text(
              _appState.screenTitle,
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
            ),
            actions: [
              IconButton(
                tooltip: 'Privacy and ethical design',
                onPressed: _showPrivacyAndEthics,
                icon: const Icon(Icons.privacy_tip_outlined),
              ),
              PopupMenuButton<AppRoute>(
                tooltip: 'Open application screen',
                icon: const Icon(Icons.apps),
                onSelected: _appState.goTo,
                itemBuilder: (context) => AppRoute.values
                    .map(
                      (screen) => PopupMenuItem(
                        value: screen,
                        child: Text(screenMenuLabel(screen)),
                      ),
                    )
                    .toList(),
              ),
            ],
          ),
          body: useNavigationRail
              ? Row(
                  children: [
                    NavigationRail(
                      selectedIndex: _appState.selectedDestination,
                      onDestinationSelected: _appState.selectDestination,
                      extended: extendNavigationRail,
                      labelType: extendNavigationRail
                          ? NavigationRailLabelType.none
                          : NavigationRailLabelType.all,
                      leading: Padding(
                        padding: const EdgeInsets.only(bottom: 12),
                        child: Icon(
                          Icons.home_repair_service,
                          color: Theme.of(context).colorScheme.primary,
                          size: 32,
                        ),
                      ),
                      destinations: navigationRailDestinations,
                    ),
                    const VerticalDivider(width: 1),
                    Expanded(child: screenBody),
                  ],
                )
              : screenBody,
          bottomNavigationBar: useNavigationRail
              ? null
              : NavigationBar(
                  selectedIndex: _appState.selectedDestination,
                  onDestinationSelected: _appState.selectDestination,
                  destinations: navigationDestinations,
                ),
          floatingActionButton: _appState.currentRoute == AppRoute.home
              ? FloatingActionButton.extended(
                  tooltip: 'Browse available tools',
                  onPressed: () => _appState.goTo(AppRoute.toolLibrary),
                  icon: const Icon(Icons.search),
                  label: const Text('Browse tools'),
                )
              : null,
        );
      },
    );
  }

  Widget _buildCurrentScreen() {
    switch (_appState.currentRoute) {
      case AppRoute.home:
        return HomeScreen(
          memberName: _appState.memberName,
          activeRequest: _appState.activeRequest,
          activeLoanCount:
              _appState.borrowedRecords.where((record) => !record.returned).length,
          onOpenTools: () => _appState.goTo(AppRoute.toolLibrary),
          onOpenBorrowed: () => _appState.goTo(AppRoute.borrowedTools),
          onOpenStatus: () => _appState.goTo(AppRoute.requestStatus),
          onOpenCoordinator: () => _appState.goTo(AppRoute.coordinatorApproval),
        );
      case AppRoute.toolLibrary:
        return ToolLibraryScreen(
          tools: _appState.tools,
          onToolSelected: _appState.selectTool,
        );
      case AppRoute.toolDetails:
        return ToolDetailsScreen(
          tool: _appState.selectedTool,
          onRequest: _appState.prepareBorrowRequest,
          onBrowseTools: () => _appState.goTo(AppRoute.toolLibrary),
        );
      case AppRoute.borrowRequest:
        return BorrowRequestScreen(
          memberName: _appState.memberName,
          tool: _appState.selectedTool,
          selectedDate: _appState.selectedReturnDate,
          errorText: _appState.returnDateError,
          onChooseDate: _chooseReturnDate,
          onSubmit: _submitBorrowRequest,
        );
      case AppRoute.requestStatus:
        return RequestStatusScreen(
          request: _appState.activeRequest,
          onBrowseTools: () => _appState.goTo(AppRoute.toolLibrary),
          onCoordinatorReview: () => _appState.goTo(AppRoute.coordinatorApproval),
        );
      case AppRoute.coordinatorApproval:
        return CoordinatorApprovalScreen(
          request: _appState.activeRequest,
          onApprove: () => _confirmRequestDecision(true),
          onReject: () => _confirmRequestDecision(false),
          onCreateRequest: () => _appState.goTo(AppRoute.toolLibrary),
          onOpenCollection: () => _appState.goTo(AppRoute.approvedCollection),
          onOpenStatus: () => _appState.goTo(AppRoute.requestStatus),
        );
      case AppRoute.approvedCollection:
        return ApprovedCollectionScreen(
          request: _appState.activeRequest,
          onConfirmCollection: _confirmCollection,
          onCoordinatorReview: () => _appState.goTo(AppRoute.coordinatorApproval),
        );
      case AppRoute.borrowedTools:
        return BorrowedToolsScreen(
          records: _appState.borrowedRecords
              .where((record) => !record.returned)
              .toList(growable: false),
          onReturnTool: (record) {
            _appState.startReturn(record);
            _showFeedback('Return workflow opened for ${record.tool.name}.');
          },
          onBrowseTools: () => _appState.goTo(AppRoute.toolLibrary),
        );
      case AppRoute.returnTool:
        return ReturnToolScreen(
          record: _appState.selectedBorrowedRecord,
          selectedCondition: _appState.selectedReturnCondition,
          notes: _appState.returnNotes,
          onConditionChanged: _appState.setReturnCondition,
          onNotesChanged: _appState.setReturnNotes,
          onSubmit: _submitReturn,
          onOpenBorrowed: () => _appState.goTo(AppRoute.borrowedTools),
        );
      case AppRoute.returnRecord:
        return ReturnRecordScreen(
          record: _appState.lastReturnedRecord,
          onOpenBorrowed: () => _appState.goTo(AppRoute.borrowedTools),
          onBrowseTools: () => _appState.goTo(AppRoute.toolLibrary),
        );
    }
  }
}

