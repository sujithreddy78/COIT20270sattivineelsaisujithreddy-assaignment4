class BorrowedToolsScreen extends StatelessWidget {
  const BorrowedToolsScreen({
    super.key,
    required this.records,
    required this.onReturnTool,
    required this.onBrowseTools,
  });

  final List<BorrowedToolRecord> records;
  final ValueChanged<BorrowedToolRecord> onReturnTool;
  final VoidCallback onBrowseTools;

  Widget _swipeToReturn(BuildContext context, BorrowedToolRecord record) {
    return Dismissible(
      key: ValueKey('borrowed-${record.tool.name}-${record.borrowedOn.toIso8601String()}'),
      direction: DismissDirection.endToStart,
      confirmDismiss: (_) async {
        onReturnTool(record);
        return false; // Swipe is a shortcut into the workflow, not a destructive delete.
      },
      background: Container(
        alignment: Alignment.centerRight,
        padding: const EdgeInsets.symmetric(horizontal: 24),
        decoration: BoxDecoration(
          color: Theme.of(context).colorScheme.secondaryContainer,
          borderRadius: BorderRadius.circular(16),
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.end,
          children: [
            Icon(
              Icons.assignment_return_outlined,
              color: Theme.of(context).colorScheme.onSecondaryContainer,
            ),
            const SizedBox(width: 8),
            Text(
              'Return tool',
              style: TextStyle(
                color: Theme.of(context).colorScheme.onSecondaryContainer,
                fontWeight: FontWeight.w700,
              ),
            ),
          ],
        ),
      ),
      child: BorrowedToolCard(
        record: record,
        onReturn: () => onReturnTool(record),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    if (records.isEmpty) {
      return EmptyState(
        icon: Icons.inventory_2_outlined,
        title: 'No borrowed tools',
        description: 'Approved and collected tools will appear here.',
        actionLabel: 'Browse tools',
        onAction: onBrowseTools,
      );
    }

    return ScrollableResponsivePage(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const SectionHeading(
            title: 'Current loans',
            subtitle:
                'Tap Return tool or swipe a loan from right to left. The visible button remains an accessible alternative.',
          ),
          const SizedBox(height: 16),
          LayoutBuilder(
            builder: (context, constraints) {
              final useGrid = constraints.maxWidth >= 760;
              if (useGrid) {
                return GridView.builder(
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 2,
                    crossAxisSpacing: 12,
                    mainAxisSpacing: 12,
                    childAspectRatio: 1.5,
                  ),
                  itemCount: records.length,
                  itemBuilder: (context, index) =>
                      _swipeToReturn(context, records[index]),
                );
              }

              return ListView.separated(
                shrinkWrap: true,
                physics: const NeverScrollableScrollPhysics(),
                itemCount: records.length,
                separatorBuilder: (context, index) => const SizedBox(height: 12),
                itemBuilder: (context, index) =>
                    _swipeToReturn(context, records[index]),
              );
            },
          ),
        ],
      ),
    );
  }
}

