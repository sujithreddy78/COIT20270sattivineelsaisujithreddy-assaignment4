class AvailabilityChip extends StatelessWidget {
  const AvailabilityChip({super.key, required this.availability});

  final ToolAvailability availability;

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    final backgroundColor = switch (availability) {
      ToolAvailability.available => colorScheme.secondaryContainer,
      ToolAvailability.onLoan => colorScheme.tertiaryContainer,
      ToolAvailability.maintenance => colorScheme.errorContainer,
    };
    final foregroundColor = switch (availability) {
      ToolAvailability.available => colorScheme.onSecondaryContainer,
      ToolAvailability.onLoan => colorScheme.onTertiaryContainer,
      ToolAvailability.maintenance => colorScheme.onErrorContainer,
    };
    final icon = switch (availability) {
      ToolAvailability.available => Icons.check_circle_outline,
      ToolAvailability.onLoan => Icons.schedule,
      ToolAvailability.maintenance => Icons.build_circle_outlined,
    };

    return Chip(
      avatar: Icon(icon, color: foregroundColor, size: 19),
      label: Text(availabilityLabel(availability)),
      backgroundColor: backgroundColor,
      labelStyle: TextStyle(
        color: foregroundColor,
        fontWeight: FontWeight.w600,
      ),
      side: BorderSide.none,
    );
  }
}

class RequestStatusChip extends StatelessWidget {
  const RequestStatusChip({super.key, required this.status});

  final BorrowRequestStatus status;

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    final isNegative = status == BorrowRequestStatus.rejected;
    return Chip(
      avatar: Icon(requestStatusIcon(status), size: 19),
      label: Text(requestStatusLabel(status)),
      backgroundColor:
          isNegative ? colorScheme.errorContainer : colorScheme.primaryContainer,
      side: BorderSide.none,
    );
  }
}

class RequestStatusPanel extends StatelessWidget {
  const RequestStatusPanel({super.key, required this.status});

  final BorrowRequestStatus status;

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    final isRejected = status == BorrowRequestStatus.rejected;
    final backgroundColor =
        isRejected ? colorScheme.errorContainer : colorScheme.primaryContainer;
    final foregroundColor = isRejected
        ? colorScheme.onErrorContainer
        : colorScheme.onPrimaryContainer;

    return Semantics(
      liveRegion: true,
      child: Container(
        width: double.infinity,
        padding: const EdgeInsets.all(22),
        decoration: BoxDecoration(
          color: backgroundColor,
          borderRadius: BorderRadius.circular(24),
        ),
        child: Row(
          children: [
            Icon(
              requestStatusIcon(status),
              size: 38,
              color: foregroundColor,
            ),
            const SizedBox(width: 14),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    requestStatusLabel(status),
                    style: Theme.of(context).textTheme.titleLarge?.copyWith(
                          color: foregroundColor,
                        ),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    requestStatusMessage(status),
                    style: TextStyle(color: foregroundColor),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}

