class ToolLibraryScreen extends StatefulWidget {
  const ToolLibraryScreen({
    super.key,
    required this.tools,
    required this.onToolSelected,
  });

  final List<ToolItem> tools;
  final ValueChanged<ToolItem> onToolSelected;

  @override
  State<ToolLibraryScreen> createState() => _ToolLibraryScreenState();
}

class _ToolLibraryScreenState extends State<ToolLibraryScreen>
    with SingleTickerProviderStateMixin {
  late final TabController _tabController;
  final TextEditingController _searchController = TextEditingController();
  String _searchText = '';
  String? _selectedCategory;

  static const categories = [
    'Woodworking',
    'Carpentry',
    'Metalworking',
    'Mechanical',
    'Power Tools',
    'Hand Tools',
  ];

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 3, vsync: this);
  }

  @override
  void dispose() {
    _tabController.dispose();
    _searchController.dispose();
    super.dispose();
  }

  List<ToolItem> _filteredTools(int tabIndex) {
    return widget.tools.where((tool) {
      final matchesSearch = tool.name.toLowerCase().contains(
                _searchText.toLowerCase(),
              ) ||
          tool.category.toLowerCase().contains(_searchText.toLowerCase());
      final matchesCategory =
          _selectedCategory == null || tool.category == _selectedCategory;
      final matchesTab = switch (tabIndex) {
        1 => tool.availability == ToolAvailability.available,
        2 => tool.availability == ToolAvailability.onLoan,
        _ => true,
      };
      return matchesSearch && matchesCategory && matchesTab;
    }).toList(growable: false);
  }

  @override
  Widget build(BuildContext context) {
    return FillResponsivePage(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          TextField(
            controller: _searchController,
            onChanged: (value) {
              setState(() {
                _searchText = value.trim();
              });
            },
            textInputAction: TextInputAction.search,
            decoration: InputDecoration(
              labelText: 'Search HMS tools',
              hintText: 'Try saw, drill or woodworking',
              prefixIcon: const Icon(Icons.search),
              suffixIcon: _searchText.isEmpty
                  ? null
                  : IconButton(
                      tooltip: 'Clear search',
                      onPressed: () {
                        _searchController.clear();
                        setState(() {
                          _searchText = '';
                        });
                      },
                      icon: const Icon(Icons.clear),
                    ),
            ),
          ),
          const SizedBox(height: 12),
          SingleChildScrollView(
            scrollDirection: Axis.horizontal,
            child: Row(
              children: categories.map((category) {
                return Padding(
                  padding: const EdgeInsets.only(right: 8),
                  child: FilterChip(
                    label: Text(category),
                    selected: _selectedCategory == category,
                    onSelected: (selected) {
                      setState(() {
                        _selectedCategory = selected ? category : null;
                      });
                    },
                  ),
                );
              }).toList(),
            ),
          ),
          const SizedBox(height: 8),
          TabBar(
            controller: _tabController,
            tabs: const [
              Tab(text: 'All'),
              Tab(text: 'Available'),
              Tab(text: 'On loan'),
            ],
          ),
          const SizedBox(height: 8),
          Expanded(
            child: TabBarView(
              controller: _tabController,
              children: List.generate(3, (tabIndex) {
                return ToolResultsView(
                  tools: _filteredTools(tabIndex),
                  onToolSelected: widget.onToolSelected,
                );
              }),
            ),
          ),
        ],
      ),
    );
  }
}

