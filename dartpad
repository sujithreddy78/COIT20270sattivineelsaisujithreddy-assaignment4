String requestStatusLabel(BorrowRequestStatus status) {
  switch (status) {
    case BorrowRequestStatus.pending:
      return 'Pending review';
    case BorrowRequestStatus.approved:
      return 'Approved';
    case BorrowRequestStatus.rejected:
      return 'Rejected';
    case BorrowRequestStatus.collected:
      return 'Collected / on loan';
    case BorrowRequestStatus.returned:
      return 'Returned';
  }
}

String requestStatusMessage(BorrowRequestStatus status) {
  switch (status) {
    case BorrowRequestStatus.pending:
      return 'The coordinator has not yet made a decision.';
    case BorrowRequestStatus.approved:
      return 'The request was approved. Review the collection details.';
    case BorrowRequestStatus.rejected:
      return 'The request was not approved. Choose another available tool.';
    case BorrowRequestStatus.collected:
      return 'The tool was collected and appears in My Borrowed Tools.';
    case BorrowRequestStatus.returned:
      return 'The tool was returned and its condition was recorded.';
  }
}

IconData requestStatusIcon(BorrowRequestStatus status) {
  switch (status) {
    case BorrowRequestStatus.pending:
      return Icons.hourglass_top;
    case BorrowRequestStatus.approved:
      return Icons.task_alt;
    case BorrowRequestStatus.rejected:
      return Icons.cancel_outlined;
    case BorrowRequestStatus.collected:
      return Icons.inventory;
    case BorrowRequestStatus.returned:
      return Icons.assignment_turned_in_outlined;
  }
}

String returnConditionLabel(ReturnCondition condition) {
  switch (condition) {
    case ReturnCondition.good:
      return 'Good';
    case ReturnCondition.minorDamage:
      return 'Minor damage';
    case ReturnCondition.damaged:
      return 'Damaged';
    case ReturnCondition.requiresMaintenance:
      return 'Requires maintenance';
  }
}

IconData returnConditionIcon(ReturnCondition condition) {
  switch (condition) {
    case ReturnCondition.good:
      return Icons.check_circle_outline;
    case ReturnCondition.minorDamage:
      return Icons.warning_amber_rounded;
    case ReturnCondition.damaged:
      return Icons.report_problem_outlined;
    case ReturnCondition.requiresMaintenance:
      return Icons.build_circle_outlined;
